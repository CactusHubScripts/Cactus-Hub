-- Cactus Hub | Universal Loader

local Scripts = {
    [10762636904] = "https://raw.githubusercontent.com/cactusscripts/Cactus-Hub/refs/heads/main/Cactus%20Hub", -- Camera TD
    [10764633350] = "https://pastebin.com/raw/r18zvmq3",                                                        -- Sakudun TD
    [10772095908] = "https://pastebin.com/raw/ic0KSfSs",                                                        -- 8Bit TD
    [10771908014] = "https://pastebin.com/raw/w88PpcGR",                                                        -- Dragon TD
    [6069634717]  = "https://raw.githubusercontent.com/cactusscripts/Cactus-Hub/refs/heads/main/sorcerer",      -- Sorcerer TD
    [7703614594]  = "https://raw.githubusercontent.com/cactusscripts/Cactus-Hub/refs/heads/main/garden",        -- Garden TD
    [10231502419] = "https://raw.githubusercontent.com/cactusscripts/Cactus-Hub/refs/heads/main/snack",         -- Snack TD
}

if not game:IsLoaded() then game.Loaded:Wait() end

local url = Scripts[game.GameId]
if not url then
    game.Players.LocalPlayer:Kick("[Cactus Hub] This game is not supported.")
    return
end

local ok, err = pcall(function()
    loadstring(game:HttpGet(url))()
end)

if not ok then
    error("[Cactus Hub] Failed to load: " .. tostring(err), 0)
end
